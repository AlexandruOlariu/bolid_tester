{
  "name": "bolid-tester",
  "version": "0.9.1",
  "private": true,
  "description": "Generic OBD2/EOBD diagnostics app (React Native/Expo). Documentation-driven — see docs/.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest",
    "test:core": "jest --selectProjects core",
    "test:ui": "jest --selectProjects ui",
    "typecheck": "tsc --noEmit",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\" jest.setup.ui.ts",
    "ci": "npm run typecheck && npm run typecheck:app && npm run lint && npm run check:release && npm run check:contrast && npm run check:capture && npm run check:store && npm run adapters:check && npm test && npm run validate:contrib",
    "check:release": "node scripts/check-signing-plugin.mjs && node scripts/check-version-sync.mjs",
    "check:contrast": "node scripts/contrast-check.mjs",
    "check:store": "node scripts/store-assets.mjs",
    "store:assets": "node scripts/store-assets.mjs --generate",
    "store:release-check": "node scripts/store-assets.mjs --release",
    "licenses": "node scripts/licenses.mjs",
    "analyze:capture": "node scripts/analyze-capture.mjs",
    "check:capture": "node scripts/analyze-capture.mjs docs/captures/synthetic-golf.csv --expect \"31 01 0301\" --quiet",
    "validate:contrib": "node scripts/validate-contrib.mjs",
    "adapters:build": "node scripts/build-adapter-matrix.mjs",
    "adapters:check": "node scripts/build-adapter-matrix.mjs --check",
    "fixtures:sim": "node scripts/run-ts.cjs scripts/record-sim-fixtures.ts",
    "eval:agent": "jest src/shared/ai/eval --selectProjects core",
    "version": "node scripts/check-version-sync.mjs --write && git add app.json",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\" \"docs/**/*.md\"",
    "prebuild:android": "expo prebuild --platform android --clean",
    "android:apk": "cd android && set SENTRY_DISABLE_AUTO_UPLOAD=true&& gradlew.bat assembleRelease",
    "android:clean": "cd android && gradlew.bat clean"
  },
  "keywords": [
    "obd2",
    "elm327",
    "ble",
    "diagnostics",
    "react-native",
    "expo"
  ],
  "license": "MIT",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.18",
    "@sentry/react-native": "~7.11.0",
    "@tamagui/config": "^1.144.4",
    "expo": "~57.0.33",
    "expo-constants": "~57.0.24",
    "expo-dev-client": "~57.0.21",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.14",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.23",
    "expo-notifications": "~57.0.25",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.31",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.26",
    "expo-splash-screen": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.28",
    "i18next": "^27.1.0",
    "intl-pluralrules": "^2.0.1",
    "lucide-react-native": "^1.17.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^18.0.1",
    "react-native": "0.86.3",
    "react-native-ble-plx": "^3.5.0",
    "react-native-bluetooth-classic": "1.73.0-rc.17",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-tcp-socket": "^6.4.3",
    "react-native-web": "^0.21.2",
    "tamagui": "^1.144.4",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@tamagui/babel-plugin": "^1.144.4",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.0",
    "@types/react": "~19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "prettier": "^3.2.5",
    "react-refresh": "0.18.0",
    "react-test-renderer": "19.2.3",
    "sharp": "^0.35.5",
    "ts-jest": "^29.1.2",
    "typescript": "~6.0.3"
  },
  "_note": "Core tooling (ts/jest/eslint) is installed and verified in CI/container. The RN runtime deps require a native build; install on a dev machine with `npm install` (or `npx expo install` to align native versions) — see docs/phase2-mobile-app.md."
}
