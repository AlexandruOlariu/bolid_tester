{
  "name": "bolid-tester",
  "version": "0.1.0",
  "private": true,
  "description": "Generic OBD2/EOBD diagnostics app (React Native/Expo). Documentation-driven — see docs/.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "ci": "npm run typecheck && npm run typecheck:app && npm run lint && npm test",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"docs/**/*.md\"",
    "prebuild:android": "expo prebuild --platform android --clean",
    "android:apk": "cd android && gradlew.bat assembleRelease",
    "android:clean": "cd android && gradlew.bat clean"
  },
  "keywords": [
    "obd2",
    "elm327",
    "ble",
    "diagnostics",
    "react-native",
    "expo"
  ],
  "license": "MIT",
  "dependencies": {
    "@tamagui/config": "^1.144.4",
    "expo": "^57.0.29",
    "expo-dev-client": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.13",
    "expo-location": "~57.0.21",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.27",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.23",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.26",
    "lucide-react-native": "^1.17.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-ble-plx": "^3.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "tamagui": "^1.144.4",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tamagui/babel-plugin": "^1.144.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.0",
    "@types/react": "~19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "react-dom": "19.2.3",
    "ts-jest": "^29.1.2",
    "typescript": "~6.0.3"
  },
  "_note": "Core tooling (ts/jest/eslint) is installed and verified in CI/container. The RN runtime deps require a native build; install on a dev machine with `npm install` (or `npx expo install` to align native versions) — see docs/phase2-mobile-app.md."
}
